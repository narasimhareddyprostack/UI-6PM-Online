from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI(title="JARVIS AI API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class ChatRequest(BaseModel):
    message: str

class ChatResponse(BaseModel):
    reply: str

@app.get("/health")
def health():
    return {"status": "ok", "service": "JARVIS AI"}

@app.post("/chat", response_model=ChatResponse)
def chat(request: ChatRequest):
    message = request.message.strip()
    if not message:
        return {"reply": "Please enter a message."}

    # Demo reply so the starter runs without an API key.
    # Replace this section with your chosen LLM provider integration.
    return {
        "reply": (
            f"Hello! I'm JARVIS. You said: “{message}”\n\n"
            "I'm running in demo mode. Connect an LLM provider in backend/main.py "
            "to enable AI-generated answers."
        )
    }
